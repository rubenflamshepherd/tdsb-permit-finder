DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tdsb_permit_finder?schema=public"

# Cloud SQL runtime settings. Leave CLOUD_SQL_INSTANCE_CONNECTION_NAME unset to
# use DATABASE_URL directly for local development and tests.
# CLOUD_SQL_INSTANCE_CONNECTION_NAME="project:region:instance"
# CLOUD_SQL_DATABASE="tdsb_permit_finder_staging"
# CLOUD_SQL_SCHEMA="tdsb_finder"
# CLOUD_SQL_USER="tdsb_stage_app"
# CLOUD_SQL_PASSWORD="replace-me"
# CLOUD_SQL_POOL_MAX="2"

# Vercel stores the complete service-account key JSON in this variable.
# Local scripts should instead point ADC at a key file outside the repository:
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/cloud-sql-connector-key.json"
# GCP_SERVICE_ACCOUNT_KEY_JSON='{"type":"service_account",...}'

# For remote Prisma CLI commands, start Cloud SQL Auth Proxy on port 5433 and
# set this to a URL whose password and database components are URL-encoded.
# CLOUD_SQL_MIGRATION_URL="postgresql://tdsb_stage_migrator:password@127.0.0.1:5433/tdsb_permit_finder_staging?schema=public"
TDSB_BASE_URL="https://tdsb.ebasefm.com"
# Community Use member credentials. Used to log in at /rentals/welcome
# (NOT the staff /auth/login page — that's a different system). Not consumed by
# the scrape code today; populate if/when an authenticated flow is added.
TDSB_USER_NAME=""
TDSB_PW=""
BOOKING_SYNC_DAYS="180"
# Keep expected TDSB failures here so strict scheduled booking sync only fails
# on unexpected failures. If the expected-failure list becomes too volatile,
# run with STRICT_BOOKING_SYNC="0" and monitor the sync summary instead.
BOOKING_SYNC_EXCLUDED_FACILITY_IDS="175,314,660,769"
STRICT_BOOKING_SYNC="0"
PERMIT_TYPE_ID="3"
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
